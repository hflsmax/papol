{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "documents",
  "description": "Least-privilege native access for bundled viewer and board windows.",
  "windows": ["viewer-*", "board-*"],
  "permissions": [
    "allow-open-document-window",
    "allow-close-document-window",
    "allow-focus-desk-window",
    "allow-diagnostic-log",
    "allow-diagnostic-recent",
    "allow-data-query",
    "allow-data-mutate",
    "allow-blob-import",
    "allow-blob-cache",
    "allow-blob-read",
    "allow-blob-ensure",
    "allow-blob-discard",
    "allow-local-setting-get",
    "allow-local-setting-set",
    "allow-local-account-set",
    "allow-local-account-remove",
    "allow-sync-now",
    "allow-opened-file-read",
    "allow-request-sign-in",
    "allow-pdf-viewer-status",
    "allow-pdf-viewer-make-default",
    "allow-pdf-viewer-prompt-dismiss",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://papol.io/**" },
        { "url": "https://files.papol.io/**" },
        { "url": "https://9315a859bb8887b2a0ca2cc576f57ae2.r2.cloudflarestorage.com/**" },
        { "url": "http://localhost:**" },
        { "url": "http://127.0.0.1:**" }
      ]
    }
  ]
}
