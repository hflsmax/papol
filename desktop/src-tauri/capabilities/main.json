{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Least-privilege native access for Papol's permanent library window.",
  "windows": ["main"],
  "permissions": [
    "allow-open-document-window",
    "allow-focus-library-window",
    "allow-open-storage-in-finder",
    "allow-diagnostic-log",
    "allow-diagnostic-recent",
    "allow-open-diagnostic-logs",
    "allow-data-query",
    "allow-data-mutate",
    "allow-import-shared-paper",
    "allow-blob-import",
    "allow-blob-cache",
    "allow-blob-read",
    "allow-local-clear-data",
    "allow-blob-discard",
    "allow-local-setting-get",
    "allow-local-setting-set",
    "allow-local-account-set",
    "allow-local-account-remove",
    "allow-local-recovery-export",
    "allow-sync-now",
    "allow-opened-file-open",
    "allow-pdf-viewer-status",
    "allow-pdf-viewer-make-default",
    "allow-pdf-viewer-prompt-dismiss",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-start-dragging",
    "core:window:allow-internal-toggle-maximize",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://mc-pony.com/**" },
        { "url": "http://localhost:**" },
        { "url": "http://127.0.0.1:**" }
      ]
    }
  ]
}
