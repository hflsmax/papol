{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papol",
  "version": "0.5.5",
  "identifier": "com.mc-pony.papol",
  "build": {
    "beforeBuildCommand": "npm run build:web",
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://127.0.0.1:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "desk",
        "create": false,
        "title": "Papol",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 },
        "backgroundColor": "#f5f6f8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": ["desk", "documents"],
      "freezePrototype": true,
      "devCsp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost ws://127.0.0.1:5173 https://9315a859bb8887b2a0ca2cc576f57ae2.r2.cloudflarestorage.com https://files.papol.io https://*.hdslb.com",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' blob: data: https://papol.io https://files.papol.io http://localhost:* http://127.0.0.1:*",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      },
      "csp": {
        "default-src": "'self'",
        "base-uri": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https://9315a859bb8887b2a0ca2cc576f57ae2.r2.cloudflarestorage.com https://files.papol.io https://*.hdslb.com",
        "font-src": "'self' data:",
        "form-action": "'self'",
        "frame-ancestors": "'none'",
        "frame-src": "'none'",
        "img-src": "'self' blob: data: https://papol.io https://files.papol.io http://localhost:* http://127.0.0.1:*",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self' 'unsafe-inline'",
        "worker-src": "'self' blob:"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Papers, and everything you think about them.",
    "longDescription": "Read papers the way you think about them. Click a citation to see every place it is cited; click a figure and it comes to you; paint the sentences that matter onto a board beside videos, web pages and your own thoughts. Works offline. Free and open source.",
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf",
        "contentTypes": ["com.adobe.pdf"],
        "rank": "Alternate"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  }
}
