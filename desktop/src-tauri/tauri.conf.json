{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Papol",
  "version": "0.1.0",
  "identifier": "com.mc-pony.papol",
  "build": {
    "beforeBuildCommand": "npm run install:web && npm run build:web",
    "beforeDevCommand": "npm run install:web && npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Papol",
        "url": "index.html",
        "width": 1280,
        "height": 820,
        "minWidth": 1000,
        "minHeight": 620,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 24 },
        "backgroundColor": "#f5f6f8",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        {
          "identifier": "desktop-runtime",
          "description": "Native window and scoped HTTP capabilities for Papol's bundled interfaces.",
          "windows": ["main", "viewer-*", "board-*"],
          "permissions": [
            "allow-open-document-window",
            "allow-close-document-window",
            "core:window:allow-start-dragging",
            "core:window:allow-internal-toggle-maximize",
            {
              "identifier": "http:default",
              "allow": [
                { "url": "https://mc-pony.com/**" },
                { "url": "http://localhost:**" },
                { "url": "http://127.0.0.1:**" }
              ]
            }
          ]
        }
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Education",
    "shortDescription": "Read, annotate, and discuss research papers.",
    "longDescription": "Papol is a workspace for reading, annotating, organizing, and discussing research papers.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": null,
      "hardenedRuntime": true
    }
  }
}
