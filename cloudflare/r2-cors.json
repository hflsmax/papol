{
  "rules": [
    {
      "allowed": {
        "origins": [
          "https://papol.io",
          "https://www.papol.io",
          "https://dev.papol.io",
          "http://localhost:5173",
          "http://127.0.0.1:5173",
          "http://localhost:8787",
          "http://127.0.0.1:8787"
        ],
        "methods": ["PUT"],
        "headers": ["content-type", "x-amz-checksum-sha256"]
      },
      "exposeHeaders": ["etag"],
      "maxAgeSeconds": 3600
    }
  ]
}
