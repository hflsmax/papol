{
  "rules": [
    {
      "allowed": {
        "origins": ["*"],
        "methods": ["GET", "HEAD"],
        "headers": ["Range", "If-None-Match", "If-Modified-Since"]
      },
      "exposeHeaders": ["Content-Length", "Content-Range", "Accept-Ranges", "ETag", "Content-Type"],
      "maxAgeSeconds": 3600
    }
  ]
}
