{
  "name": "papol-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "npm run test:unit && VITE_BASE=/papol/ npm run build && npm run smoke:browser && npm run smoke:upload && npm run smoke:folder",
    "test:unit": "node --test --import ./src/browserGlobals.mjs src/*.test.js",
    "smoke:browser": "node scripts/browser-smoke.mjs",
    "smoke:upload": "node scripts/upload-smoke.mjs",
    "smoke:folder": "node scripts/folder-smoke.mjs",
    "test:sync": "node --test --import ./src/browserGlobals.mjs src/connectivity.test.js src/nativeSync.test.js src/nativeBridge.test.js src/replicaShapes.test.js src/desktopUpload.test.js src/desktopCards.test.js src/desktopRooms.test.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-http": "^2.6.1",
    "fflate": "^0.8.3",
    "linkpeek": "^2.1.5",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.3.0"
  }
}
